@@ -29,6 +29,18 @@ class CNF(pl.LightningModule, ABC):
         self.optimizer = torch.optim.Adam(self.transform.parameters(), lr=config["lr"])
         self.save_hyperparameters(config)
 
+    def rebuild_distributions(self, device=None):
+        """Recreate non-buffer torch distributions after Lightning device moves."""
+        if device is None:
+            device = self.device
+        dim_y = self.config["dim_y"]
+        base = dist.MultivariateNormal(torch.zeros(dim_y, device=device),
+                                       torch.eye(dim_y, device=device))
+        self.dist_y_given_x_training = dist.ConditionalTransformedDistribution(base, [self.transform])
+
+    def on_fit_start(self):
+        self.rebuild_distributions(self.device)
+
     def configure_optimizers(self):
         return self.optimizer
 
